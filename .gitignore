.env
.venv/
__pycache__/
*.pyc
.DS_Store

# Cloud Run Job が生成する公開物のビルド出力（コミットしない）
public/
# generate_pages.py が docs/ に生成するビルド出力（ソースは templates/ と assets/site/）
# docs/power-automate.html は手書きのため追跡対象（ここでは無視しない）
docs/index.html
docs/subscribe.html
docs/articles/
docs/assets/
docs/data/
docs/feeds/
# generate_pages.py が生成する共有メタ（表示定数。Web/アプリが参照する単一情報源）。
# 生成物のためコミットしない（正本は generate_pages.py の定数＋データ由来のソース一覧）
shared/meta.json

# Expo モバイルアプリ（app/）の依存・ビルド成果物
app/node_modules/
app/.expo/
app/dist/
app/ios/
app/android/

# firebase-tools が生成するローカルキャッシュ
.firebase/

.claude/settings.local.json
