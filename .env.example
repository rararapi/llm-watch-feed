# ============================================================
# ローカル開発用の環境変数。`cp .env.example .env` で各自作成して設定する。
# .env は .gitignore 済みでコミットされない。collect.py / generate_feeds.py /
# gcs_sync.py が起動時にこの .env を読み込む（load_dotenv）。
#
# ★ .env とは別に各自で必要な事前準備（.env には入れない）:
#   1) 依存インストール:        python -m venv .venv && . .venv/bin/activate
#                              pip install -r requirements.txt
#   2) Vertex AI 認証(ADC):     gcloud auth application-default login
#      ※ APIキーは使わない。認証情報は ~/.config/gcloud に保存され .env には入れない。
# ============================================================

# --- Vertex AI（記事の分析・要約: collect.py / regenerate_summaries.py）---
# 未設定だとダミー要約で動作（Vertex未使用）。実際に分析するなら必須。
GCP_PROJECT=ai-watch-feed
# 任意（既定値あり）
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# --- フィード生成 / サイト生成（generate_feeds.py / generate_pages.py）---
# 配信物の絶対URL基準。フィードの自己リンクに加え、記事ページの OGP/canonical/asset の
# 基準にもなる（= 記事が実際に配信される公開GCSオリジン）。公開GCSバケットが配信する。
SITE_URL=https://storage.googleapis.com/ai-watch-feed-llm-watch-public

# --- サイトのブランド表記（generate_pages.py。任意・既定あり）---
#SITE_NAME=AI News Watch
#SITE_TAGLINE=AIニュースを自動収集・要約してお届け

# --- 入出力パス（任意・既定あり）---
# 既定: docs/data/models.json / docs/feeds / docs（PAGES_DIR=サイト生成先=バケット直下のミラー）
#MODELS_JSON_PATH=docs/data/models.json
#FEEDS_DIR=docs/feeds
#PAGES_DIR=docs

# --- GCS 同期（gcs_sync.py をローカルで実行する場合のみ。通常はクラウドのジョブが担当）---
# 公開バケットへ download/upload/publish するときに使う。
#GCS_BUCKET=ai-watch-feed-llm-watch-public
#GCS_OBJECT=data/models.json
#SITE_DIR=docs

# --- サイトデプロイ（deploy_site.sh = firebase deploy。任意）---
# 未設定なら .firebaserc の default(ai-watch-feed) を使用。認証は別途 `firebase login`。
#FIREBASE_PROJECT=ai-watch-feed
