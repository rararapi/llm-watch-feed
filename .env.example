# ============================================================
# ローカル開発用の環境変数。`cp .env.example .env` で各自作成して設定する。
# .env は .gitignore 済みでコミットされない。collect.py / generate_feeds.py /
# gcs_sync.py が起動時にこの .env を読み込む（load_dotenv）。
#
# ★ .env とは別に各自で必要な事前準備（.env には入れない）:
#   1) 依存インストール:        python -m venv .venv && . .venv/bin/activate
#                              pip install -r requirements.txt
#   2) Vertex AI 認証(ADC):     gcloud auth application-default login
#      ※ APIキーは使わない。認証情報は ~/.config/gcloud に保存され .env には入れない。
# ============================================================

# --- Vertex AI（記事の分析・要約: collect.py / regenerate_summaries.py）---
# 未設定だとダミー要約で動作（Vertex未使用）。実際に分析するなら必須。
GCP_PROJECT=ai-watch-feed
# 任意（既定値あり）
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-3.1-flash-lite

# --- AI画像生成（generate_images.py。重要度Aの記事にアイキャッチ画像を生成）---
# Vertex AI の Gemini 2.5 Flash Image を ADC で利用（GCP_PROJECT / VERTEX_LOCATION を共用）。
# AI画像は image_url(記事元OG画像)とは別の image_generated_url に保存し、
# テンプレは AI画像 → OG画像 → プレースホルダ の順で表示する。
# 未設定（GCP_PROJECT 無し）・GCS_BUCKET 無し・生成失敗のいずれでも画像なしで完走する。
# いずれも任意（既定値あり）:
#VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
#IMAGE_MIN_IMPORTANCE=B     # この重要度「以上」を生成（A>B>C、既定 B=A・B生成 / Cは対象外）
#IMAGE_MAX_PER_RUN=5        # 1回の実行で生成する最大枚数（コスト上限）
# 画像URLのベース（既定: https://storage.googleapis.com/<GCS_BUCKET>）。画像は <base>/images/<id>.webp で配信。
#IMAGE_BASE_URL=https://storage.googleapis.com/ai-watch-feed-llm-watch-public

# --- フィード生成 / サイト生成（generate_feeds.py / generate_pages.py）---
# 配信物の絶対URL基準。フィードの自己リンクに加え、記事ページの OGP/canonical/asset の
# 基準にもなる（= Firebase Hosting の公開URL）。
SITE_URL=https://ai-watch-feed.web.app
# フィードファイル（feeds/*.xml）の配信元URL（atom:link rel="self" 用）。
# フィードは GCS に置くため SITE_URL とは別に設定する。
FEEDS_BASE_URL=https://storage.googleapis.com/ai-watch-feed-llm-watch-public

# --- サイトのブランド表記（generate_pages.py。任意・既定あり）---
#SITE_NAME=AI News Watch
#SITE_TAGLINE=AIニュースを自動収集・要約してお届け

# --- 入出力パス（任意・既定あり）---
# 既定: docs/data/models.json / docs/feeds / docs（PAGES_DIR=サイト生成先=バケット直下のミラー）
#MODELS_JSON_PATH=docs/data/models.json
#FEEDS_DIR=docs/feeds
#PAGES_DIR=docs

# --- GCS 同期（gcs_sync.py をローカルで実行する場合のみ。通常はクラウドのジョブが担当）---
# 公開バケットへ download/upload/publish するときに使う。
#GCS_BUCKET=ai-watch-feed-llm-watch-public
#GCS_OBJECT=data/models.json
#SITE_DIR=docs

# --- Firebase Hosting デプロイ（firebase_hosting_deploy.py / deploy_site.sh）---
# FIREBASE_SITE_ID: REST API でのデプロイ対象サイト ID（既定: ai-watch-feed）
# FIREBASE_PROJECT: deploy_site.sh（firebase CLI）の対象プロジェクト。未設定なら .firebaserc の default。
#FIREBASE_SITE_ID=ai-watch-feed
#FIREBASE_PROJECT=ai-watch-feed
